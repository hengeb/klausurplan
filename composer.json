{
    "name": "schule/klausurplan",
    "description": "Klausurtermin-Verwaltung für Oberstufe via LTI 1.3 / Moodle",
    "type": "project",
    "require": {
        "php": "^8.5",
        "longhornopen/lti": "^5.3",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Klausurplan\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload-dev": {
        "psr-4": {
            "Klausurplan\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "bin/test-integration.sh",
        "test:js": "npm test"
    },
    "scripts-descriptions": {
        "test": "Unit-Tests (schnell, ohne Datenbank)",
        "test:unit": "Unit-Tests (schnell, ohne Datenbank)",
        "test:integration": "Integrationstests gegen eine Wegwerf-Datenbank in Docker",
        "test:js": "Frontend-Tests (jsdom, benötigt npm install)"
    }
}
